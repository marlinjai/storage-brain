# Storage Brain — Environment Variables (Node.js / self-hosted mode)

# S3-compatible storage (required)
S3_BUCKET=storage-brain
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/storagebrain

# Admin API key for tenant management (required)
ADMIN_API_KEY=admin-dev-key

# Secret for signing download URLs (required)
URL_SIGNING_SECRET=dev-signing-secret

# Server port (default: 3000)
PORT=3000

# Environment label (development | staging | production)
ENVIRONMENT=development

# Fully-qualified public base URL used when constructing shareable file URLs
# (signed + permanent). Set this in production so links don't leak internal
# hostnames like http://api. If unset, falls back to the inbound request host.
PUBLIC_BASE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Dashboard (packages/dashboard) — Next.js, server-only vars (never client)
# ----------------------------------------------------------------------------

# auth-brain identity service base URL (default: https://auth.lumitra.co)
AUTH_BRAIN_URL=https://auth.lumitra.co

# OpenFGA endpoint + store used by can() platform-admin checks
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=
# Optional: OpenFGA authorization model id and pre-shared bearer token
OPENFGA_MODEL_ID=
OPENFGA_API_TOKEN=

# Backend credential the dashboard server uses to drive Storage Brain on the
# auth-brain path (server-only: never exposed to the client bundle, never logged)
STORAGE_BRAIN_ADMIN_KEY=admin-dev-key
STORAGE_BRAIN_URL=https://api.storage-brain.lumitra.co

# iron-session secret for the legacy admin-key login (>= 32 chars). REQUIRED in
# production; a dev-only fallback is used when unset outside production.
SESSION_SECRET=
