{
  "name": "storage-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Edge-native file storage micro-product built on Cloudflare Workers",
  "scripts": {
    "dev": "docker compose up -d postgres minio minio-setup && infisical run --token=\"$($HOME/software-dev/infra/scripts/infisical-mi-token.sh)\" --domain=https://infisical.lumitra.co --env=dev --projectId=86dcae14-6cb2-473b-8b2d-43b37977f04e -- pnpm --filter @storage-brain/api start:node",
    "dev:dashboard": "pnpm --filter @storage-brain/dashboard dev",
    "dev:workers": "pnpm --filter @storage-brain/api dev",
    "dev:stop": "docker compose down",
    "dev:sdk": "pnpm --filter @marlinjai/storage-brain-sdk dev",
    "build": "pnpm -r --if-present run build",
    "build:sdk": "pnpm --filter @marlinjai/storage-brain-sdk build",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "lint:fix": "eslint packages/*/src --ext .ts,.tsx --fix",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf packages/*/dist packages/*/.wrangler",
    "publish:sdk": "pnpm --filter @marlinjai/storage-brain-sdk build && pnpm --filter @marlinjai/storage-brain-sdk publish --access public",
    "docs:dev": "clearify dev",
    "docs:build": "clearify build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@marlinjai/clearify": "^1.11.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "husky": "^9.1.7",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
