{
  "name": "storage-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Edge-native file storage micro-product built on Cloudflare Workers",
  "scripts": {
    "dev": "pnpm --filter @storage-brain/api dev",
    "dev:sdk": "pnpm --filter @marlinjai/storage-brain-sdk dev",
    "build": "pnpm -r --if-present run build",
    "build:sdk": "pnpm --filter @marlinjai/storage-brain-sdk build",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "lint:fix": "eslint packages/*/src --ext .ts,.tsx --fix",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf packages/*/dist packages/*/.wrangler",
    "publish:sdk": "pnpm --filter @marlinjai/storage-brain-sdk build && pnpm --filter @marlinjai/storage-brain-sdk publish --access public",
    "docs:dev": "clearify dev",
    "docs:build": "clearify build"
  },
  "devDependencies": {
    "@marlinjai/clearify": "^1.11.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
