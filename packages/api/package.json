{
  "name": "@storage-brain/api",
  "version": "0.1.0",
  "private": true,
  "description": "Storage Brain API - Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "start:node": "tsx src/node.ts",
    "db:migrate": "wrangler d1 migrations apply storage-brain-db",
    "db:migrate:local": "wrangler d1 migrations apply storage-brain-db --local",
    "db:studio": "wrangler d1 studio storage-brain-db"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/node-server": "^1.13.0",
    "@marlinjai/auth-brain-sdk": "^1.1.0",
    "@marlinjai/brain-core": "^0.2.1",
    "@storage-brain/shared": "workspace:*",
    "hono": "^4.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "@types/node": "^20.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "wrangler": "^3.24.0"
  }
}
