{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/tenants/[id]",
      "regex": "^/api/tenants/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/tenants/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/tenants/[id]/files",
      "regex": "^/api/tenants/([^/]+?)/files(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/tenants/(?<nxtPid>[^/]+?)/files(?:/)?$"
    },
    {
      "page": "/api/tenants/[id]/files/[fileId]",
      "regex": "^/api/tenants/([^/]+?)/files/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPfileId": "nxtPfileId"
      },
      "namedRegex": "^/api/tenants/(?<nxtPid>[^/]+?)/files/(?<nxtPfileId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/tenants/[id]/files/[fileId]/signed-url",
      "regex": "^/api/tenants/([^/]+?)/files/([^/]+?)/signed\\-url(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPfileId": "nxtPfileId"
      },
      "namedRegex": "^/api/tenants/(?<nxtPid>[^/]+?)/files/(?<nxtPfileId>[^/]+?)/signed\\-url(?:/)?$"
    },
    {
      "page": "/api/tenants/[id]/regenerate-key",
      "regex": "^/api/tenants/([^/]+?)/regenerate\\-key(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/tenants/(?<nxtPid>[^/]+?)/regenerate\\-key(?:/)?$"
    },
    {
      "page": "/api/tenants/[id]/workspaces",
      "regex": "^/api/tenants/([^/]+?)/workspaces(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/tenants/(?<nxtPid>[^/]+?)/workspaces(?:/)?$"
    },
    {
      "page": "/tenants/[tenantId]",
      "regex": "^/tenants/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtenantId": "nxtPtenantId"
      },
      "namedRegex": "^/tenants/(?<nxtPtenantId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tenants/[tenantId]/files",
      "regex": "^/tenants/([^/]+?)/files(?:/)?$",
      "routeKeys": {
        "nxtPtenantId": "nxtPtenantId"
      },
      "namedRegex": "^/tenants/(?<nxtPtenantId>[^/]+?)/files(?:/)?$"
    },
    {
      "page": "/tenants/[tenantId]/settings",
      "regex": "^/tenants/([^/]+?)/settings(?:/)?$",
      "routeKeys": {
        "nxtPtenantId": "nxtPtenantId"
      },
      "namedRegex": "^/tenants/(?<nxtPtenantId>[^/]+?)/settings(?:/)?$"
    },
    {
      "page": "/tenants/[tenantId]/workspaces",
      "regex": "^/tenants/([^/]+?)/workspaces(?:/)?$",
      "routeKeys": {
        "nxtPtenantId": "nxtPtenantId"
      },
      "namedRegex": "^/tenants/(?<nxtPtenantId>[^/]+?)/workspaces(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/tenants",
      "regex": "^/tenants(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tenants(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}