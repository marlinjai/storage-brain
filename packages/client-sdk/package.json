{
  "name": "@storage-brain/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Storage Brain file upload service",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@storage-brain/shared": "*"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "storage",
    "upload",
    "cloudflare",
    "r2",
    "file-upload",
    "sdk"
  ],
  "license": "MIT"
}
